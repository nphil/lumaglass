#!/bin/sh
# LumaGlass on-device engine (POSIX sh / busybox ash only).
#
# Verb map (each verb prints exactly one JSON object on stdout, exit 0/nonzero):
#   status                 -> current measured state
#   apply                  -> build+bind the mod, restart compositor, relaunch Home
#   revert                 -> unbind everything, restore icon backups, back to stock
#   persist on|off         -> toggle the boot-hook symlink in webosbrew init.d
#   fps on|off             -> toggle the compositor FPS debug overlay
#   ntfy set <url>|off|test -> configure/test ntfy.sh notifications
#   log [n]                -> last n log lines (default 20)
#   version                -> version string from appinfo.json
#
# Nothing is ever written outside $APPDIR, $STATE (/var/lib/lumaglass), and
# /var/lib/webosbrew/init.d/50-lumaglass.

set -u

APPDIR=$(cd "$(dirname "$0")/.." && pwd)
STATE=/var/lib/lumaglass
CONFIG="$STATE/config.json"
LOGFILE="$STATE/log"
ASSETS="$STATE/assets"
BACKUP="$STATE/backup"
STAMP="$STATE/.built-stamp"
COMPOSITOR_STAGE="$STATE/compositor.qml"
WALLPAPER_STAGE="$STATE/wall_1080.png"
# Written by the last full apply that passed verification: a hash of the staged
# set. boot-bind only fast-binds a set that carries this stamp.
VERIFIED="$STATE/.verified"
# Epoch at which the current staged content became live. Survives a re-apply
# that changes nothing, so the compositor can be judged against the real time
# the content it read was bound, not the time of the latest no-op apply.
BOUND_AT="$STATE/.bound-at"
# Present from boot-bind until the boot's apply reports ok. Found at the next
# boot, it means the previous one never completed, and the fast path is skipped
# once - the same shape as Homebrew Channel's own failsafe.
BOOT_PENDING="$STATE/.boot-pending"

APPINFO="$APPDIR/appinfo.json"
QML_SRC="$APPDIR/payload/compositor/StarfishFullscreenContainer.qml"
HOME_XML_SRC="$APPDIR/payload/home/home.xml"
EN_SED_SRC="$APPDIR/payload/home/en.json.sed"
WALL_SRC="$APPDIR/payload/wallpaper/wall_1080.png"
BG_HD_SRC="$APPDIR/payload/wallpaper/bg_hd.png"
BG_2K_SRC="$APPDIR/payload/wallpaper/bg_2k.png"
BG_4K_SRC="$APPDIR/payload/wallpaper/bg_4k.png"

QML_TARGET_1=/usr/lib/qml/WebOSCompositor/views/fullscreen/StarfishFullscreenContainer.qml
QML_TARGET_2=/usr/lib/qt5/qml/WebOSCompositor/views/fullscreen/StarfishFullscreenContainer.qml
STOCK_ASSETS=/usr/palm/applications/com.webos.app.home/data/flutter_assets/assets

HOME_PKILL_PATTERN="flutter-client -i com.webos.app.home"
HOME_LAUNCH_URI="luna://com.webos.applicationManager/launch"
HOME_LAUNCH_PARAMS='{"id":"com.webos.app.home"}'
SURFACE_SVC=surface-manager-daemon.service
MSGLOG=/var/log/messages
# Seconds to wait after the compositor reports active before launching Home.
# Measured: 14s is reliable on webOS 10.2.1; shorter leaves a black screen.
SURFACE_SETTLE=14
SCREEN_ON_URI="luna://com.webos.service.tvpower/power/turnOnScreen"
AUTOSTART_LINK=/var/lib/webosbrew/init.d/50-lumaglass
AUTOSTART_SRC="$APPDIR/tools/autostart.sh"
LOCKFILE=/var/lib/lumaglass/mutate.lock
# Seconds a second mutation waits for the first to finish. An apply takes ~30s
# at worst, so this is generous without hanging a caller forever.
LOCK_WAIT=180

VERB="${1:-}"

# ---------------------------------------------------------------- utilities

json_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr '\n\r\t' '   '
}

emit_error() {
  msg=$(json_escape "$1")
  printf '{"ok":false,"error":"%s"}\n' "$msg"
}

mtime_epoch() {
  date -r "$1" +%s 2>/dev/null || echo 0
}

log_line() {
  mkdir -p "$STATE" 2>/dev/null
  ts=$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)
  msg=$(printf '%s' "$1" | tr '\n' ' ')
  printf '%s %s\n' "$ts" "$msg" >> "$LOGFILE" 2>/dev/null
  if [ -f "$LOGFILE" ]; then
    lc=$(wc -l < "$LOGFILE" 2>/dev/null | tr -d ' ')
    [ -n "$lc" ] || lc=0
    if [ "$lc" -gt 200 ] 2>/dev/null; then
      tail -n 200 "$LOGFILE" > "$LOGFILE.trim.$$" 2>/dev/null && mv "$LOGFILE.trim.$$" "$LOGFILE"
    fi
  fi
}

# ------------------------------------------------------------- mount helpers

is_mounted() {
  # $1 = exact absolute target path. Matches only the literal bind target,
  # never the dozens of per-app jail mirrors webOS maintains at paths like
  # /mnt/lg/*/var/palm/jail/<app>/usr/lib/qml/... which also contain the
  # same suffix and would otherwise inflate the count.
  mount 2>/dev/null | grep -qF -- " on $1 type "
}

count_mounts() {
  n=0
  is_mounted "$QML_TARGET_1" && n=$((n+1))
  is_mounted "$QML_TARGET_2" && n=$((n+1))
  is_mounted "$STOCK_ASSETS" && n=$((n+1))
  echo "$n"
}

drain_umount() {
  while umount "$1" >/dev/null 2>&1; do :; done
}

# ------------------------------------------------------------- luna helpers

kill_home_app() {
  # Safe by construction: this exact pattern is the Home flutter client's own
  # process command line, never a substring of this script's own invocation.
  pkill -f "$HOME_PKILL_PATTERN" >/dev/null 2>&1
  return 0
}

home_running() {
  # Home runs in its own namespace, where busybox `ps` cannot see it: `ps`
  # reports zero flutter-client processes while the app is demonstrably
  # running and on screen. Scan /proc/*/cmdline instead, and anchor on the
  # binary path so this never matches a shell that merely mentions the app id
  # on its own command line.
  for p in /proc/[0-9]*; do
    c=$(tr '\0' ' ' < "$p/cmdline" 2>/dev/null)
    case "$c" in
      /usr/bin/flutter-client*com.webos.app.home*) return 0 ;;
    esac
  done
  return 1
}

relaunch_home() {
  # Sequence and pacing both matter, and both were established empirically:
  #
  #   turnOnScreen, then ONE launch, then let it settle.
  #
  # Hammering launch requests every couple of seconds while the compositor is
  # still coming up leaves the panel black indefinitely, even though the Home
  # process exists, the log has already printed NL_HOME_SHOWN, and
  # getForegroundAppInfo already reports com.webos.app.home. All three of
  # those signals go true well before anything is actually composited, so none
  # of them can be used as the readiness gate - only patience works. The
  # caller is responsible for the post-restart settle before calling this.
  # turnOnScreen exists for the interactive path: a compositor restart can
  # leave the panel blanked, and the user asked for the screen. On the boot
  # path it is wrong: after a crash-recovery "reboot to suspend" the set is
  # booting in order to go back to standby, and forcing the panel on here
  # turned a TV the user had switched off back on. The hook sets
  # LUMAGLASS_BOOT=1; the panel is then whatever the system decided.
  i=0
  while [ "$i" -lt 3 ]; do
    [ "${LUMAGLASS_BOOT:-0}" = "1" ] || luna-send -n 1 "$SCREEN_ON_URI" '{}' >/dev/null 2>&1
    luna-send -n 1 "$HOME_LAUNCH_URI" "$HOME_LAUNCH_PARAMS" >/dev/null 2>&1
    sleep 8
    if home_running; then
      log_line "home up after $i relaunch attempt(s)"
      return 0
    fi
    i=$((i+1))
  done
  log_line "home did not come back after 3 launch attempts"
  return 1
}

wait_surface_active() {
  # Bounded poll (~40s) for surface-manager-daemon.service to report active.
  i=0
  while [ "$i" -lt 40 ]; do
    st=$(systemctl is-active "$SURFACE_SVC" 2>/dev/null)
    if [ "$st" = "active" ]; then return 0; fi
    sleep 1
    i=$((i+1))
  done
  return 1
}

restart_surface() {
  systemctl restart "$SURFACE_SVC" >/dev/null 2>&1
  wait_surface_active || return 1
  # is-active goes true almost immediately (Type=notify), long before the
  # compositor can present a frame. Without this settle the subsequent Home
  # launch is accepted and then never composited, leaving a black screen.
  sleep "$SURFACE_SETTLE"
  return 0
}

surface_start_uptime() {
  # Seconds after boot at which the running compositor started, from field 22
  # of /proc/<pid>/stat (clock ticks since boot, CLK_TCK=100 on this kernel).
  #
  # Not /proc/<pid>'s mtime. That is only the time the /proc entry was last
  # instantiated - on this kernel it read "176s ago" for a compositor that
  # had been running for 829s - and trusting it made apply skip a restart the
  # compositor needed, leaving stock QML under a modded layout.
  #
  # Monotonic on purpose: the wall clock is unsynchronised for the first
  # seconds of boot (systemd stamps early units in 2022), so any comparison in
  # epoch seconds across that window is meaningless.
  p=$(pgrep -x surface-manager 2>/dev/null | head -n1)
  [ -n "$p" ] || return 1
  t=$(awk '{print int($22 / 100)}' "/proc/$p/stat" 2>/dev/null)
  [ -n "$t" ] || return 1
  printf '%s\n' "$t"
}

boot_id() { cat /proc/sys/kernel/random/boot_id 2>/dev/null; }
uptime_s() { cut -d. -f1 /proc/uptime 2>/dev/null; }

record_bound_now() {
  # The content now live was bound at this instant of this boot. Scoped to the
  # boot id so a stale record from a previous boot can never be mistaken for
  # this one's.
  printf '%s %s\n' "$(boot_id)" "$(uptime_s)" > "$BOUND_AT"
}

bound_at_uptime() {
  # Seconds after boot the live content was bound, or nothing if the record is
  # missing or from another boot.
  read -r bid up < "$BOUND_AT" 2>/dev/null || return 1
  [ "$bid" = "$(boot_id)" ] || return 1
  printf '%s\n' "$up"
}

panel_is_active() {
  # Only "Active" means the panel is actually presenting. Restarting the
  # compositor while the set is in standby or suspending is pointless work on
  # the boot path, and it is how a half-finished apply used to be interrupted.
  luna-send -n 1 luna://com.webos.service.tvpower/power/getPowerState '{}' 2>/dev/null \
    | tr -d '\n' | grep -q '"state"[[:space:]]*:[[:space:]]*"Active"'
}

take_mutation_lock() {
  # Serialise anything that mounts, unmounts or restarts the compositor. Two
  # concurrent applies interleave their unmount/stage/bind steps and can leave
  # the wrong number of mounts live; the boot hook made this reachable, because
  # a user launching the app can now overlap the detached boot apply.
  mkdir -p "$(dirname "$LOCKFILE")" 2>/dev/null
  exec 9>"$LOCKFILE" 2>/dev/null || return 0
  if ! flock -x -w "$LOCK_WAIT" 9 2>/dev/null; then
    return 1
  fi
  return 0
}

# --------------------------------------------------------------- config i/o

write_config() {
  # $1=fps $2=persist $3=ntfy_enabled $4=ntfy_url  (fps/persist/enabled: true|false)
  mkdir -p "$STATE" 2>/dev/null
  url_esc=$(json_escape "$4")
  tmp="$CONFIG.tmp.$$"
  printf '{"fps":%s,"ntfy":{"url":"%s","enabled":%s},"persist":%s}\n' "$1" "$url_esc" "$3" "$2" > "$tmp" && mv "$tmp" "$CONFIG"
}

ensure_config() {
  [ -f "$CONFIG" ] || write_config false false false ""
}

cfg_get_bool() {
  # $1 = key name (fps|persist|enabled)
  sed -n "s/.*\"$1\"[ ]*:[ ]*\\(true\\|false\\).*/\\1/p" "$CONFIG" 2>/dev/null | head -n1
}

cfg_get_str() {
  # $1 = key name (url)
  sed -n "s/.*\"$1\"[ ]*:[ ]*\"\\([^\"]*\\)\".*/\\1/p" "$CONFIG" 2>/dev/null | head -n1
}

cfg_read_all() {
  ensure_config
  CFG_FPS=$(cfg_get_bool fps); [ -n "$CFG_FPS" ] || CFG_FPS=false
  CFG_PERSIST=$(cfg_get_bool persist); [ -n "$CFG_PERSIST" ] || CFG_PERSIST=false
  CFG_NTFY_ENABLED=$(cfg_get_bool enabled); [ -n "$CFG_NTFY_ENABLED" ] || CFG_NTFY_ENABLED=false
  CFG_NTFY_URL=$(cfg_get_str url)
}

set_cfg_bool() {
  # $1 = fps|persist|enabled  $2 = true|false
  cfg_read_all
  case "$1" in
    fps) CFG_FPS="$2" ;;
    persist) CFG_PERSIST="$2" ;;
    enabled) CFG_NTFY_ENABLED="$2" ;;
  esac
  write_config "$CFG_FPS" "$CFG_PERSIST" "$CFG_NTFY_ENABLED" "$CFG_NTFY_URL"
}

set_cfg_ntfy_url() {
  cfg_read_all
  CFG_NTFY_URL="$1"
  write_config "$CFG_FPS" "$CFG_PERSIST" "$CFG_NTFY_ENABLED" "$CFG_NTFY_URL"
}

# ----------------------------------------------------------------- ntfy i/o

ntfy_notify() {
  # $1 = message. Always non-fatal: never propagates a failure to the caller.
  msg="$1"
  cfg_read_all
  [ "$CFG_NTFY_ENABLED" = "true" ] || return 0
  [ -n "$CFG_NTFY_URL" ] || return 0
  curl -fsS -m 10 -H 'Title: LumaGlass' -H 'Tags: tv' -d "$msg" "$CFG_NTFY_URL" >/dev/null 2>&1
  return 0
}

# ---------------------------------------------------------- system readouts

get_version() {
  sed -n 's/.*"version"[ ]*:[ ]*"\([^"]*\)".*/\1/p' "$APPINFO" 2>/dev/null | head -n1
}

get_firmware() {
  if [ -r /etc/os-release ]; then
    v=$(sed -n 's/^VERSION_ID=\(.*\)$/\1/p' /etc/os-release 2>/dev/null | head -n1 | tr -d '"')
    if [ -n "$v" ]; then printf '%s' "$v"; return 0; fi
  fi
  if [ -r /etc/starfish-release ]; then
    v=$(sed -n 's/^[A-Za-z]* release \([0-9.]*\).*/\1/p' /etc/starfish-release 2>/dev/null | head -n1)
    if [ -n "$v" ]; then printf '%s' "$v"; return 0; fi
  fi
  printf '%s' ""
}

get_model() {
  if [ -r /etc/prefs/properties/machineName ]; then
    tr -d '\n' < /etc/prefs/properties/machineName 2>/dev/null
    return 0
  fi
  printf '%s' ""
}

# ------------------------------------------------------------- QML staging

stage_compositor() {
  # $1 = fps (true|false), $2 = output path (default: the live stage). Always
  # rebuilt from the pristine payload, so the payload itself is never touched
  # and repeated calls are idempotent.
  fps="$1"; out="${2:-$COMPOSITOR_STAGE}"
  mkdir -p "$STATE" 2>/dev/null
  sed -e "s#file:///tmp/hx/wall_1080\\.png#file://$WALLPAPER_STAGE#" \
      -e "s/property bool debugFps: true/property bool debugFps: $fps/" \
      "$QML_SRC" > "$out.tmp.$$" && mv "$out.tmp.$$" "$out"
}

staged_hash() {
  # Identity of the whole staged set: everything a bind exposes to the
  # compositor and to Home.
  cat "$COMPOSITOR_STAGE" "$WALLPAPER_STAGE" "$ASSETS/home.xml" "$ASSETS/i18n/en.json" 2>/dev/null | md5sum | cut -c1-32
}

resolve_qml_targets() {
  # On this firmware /usr/lib/qt5/qml/WebOSCompositor is a symlink to
  # /usr/lib/qml/WebOSCompositor, so both QML paths are the same inode and a
  # second bind would just stack a redundant mount on the same mountpoint.
  # Resolve and deduplicate, then bind each distinct target exactly once.
  qml1=$(readlink -f "$QML_TARGET_1" 2>/dev/null); [ -n "$qml1" ] || qml1="$QML_TARGET_1"
  qml2=$(readlink -f "$QML_TARGET_2" 2>/dev/null); [ -n "$qml2" ] || qml2="$QML_TARGET_2"
  qml_targets="$qml1"
  [ "$qml2" = "$qml1" ] || qml_targets="$qml1 $qml2"
}

all_binds_live() {
  resolve_qml_targets
  for t in $qml_targets "$STOCK_ASSETS"; do
    is_mounted "$t" || return 1
  done
  return 0
}

# ------------------------------------------------------------------- revert

do_revert_internal() {
  # Mechanics only; never prints. Sets REVERT_CHANGED=1 if anything was
  # actually mounted or restored, so callers can decide whether a disruptive
  # compositor restart / Home relaunch is warranted.
  REVERT_CHANGED=0

  for p in "$QML_TARGET_1" "$QML_TARGET_2" "$STOCK_ASSETS"; do
    if is_mounted "$p"; then REVERT_CHANGED=1; fi
    drain_umount "$p"
  done

  # Restore any icon appinfo.json backups generically: each backup's
  # destination path is recorded in a sidecar .origpath file so revert never
  # has to guess an app-id-to-path convention.
  if [ -d "$BACKUP" ]; then
    for origfile in "$BACKUP"/*.origpath; do
      [ -e "$origfile" ] || continue
      base=${origfile%.origpath}
      content="$base.appinfo.json"
      [ -f "$content" ] || continue
      destpath=$(cat "$origfile" 2>/dev/null)
      if [ -n "$destpath" ]; then
        if cp -f "$content" "$destpath" 2>/dev/null; then
          rm -f "$content" "$origfile"
          REVERT_CHANGED=1
        fi
      fi
    done
  fi

  # Nothing of ours is live any more, so the next apply must not inherit the
  # old bind time and skip a restart the compositor genuinely needs.
  rm -f "$BOUND_AT" "$BOOT_PENDING"

  if [ "$REVERT_CHANGED" -eq 1 ]; then
    restart_surface >/dev/null 2>&1
    kill_home_app
    relaunch_home
  fi
  return 0
}

verb_revert() {
  if ! take_mutation_lock; then
    emit_error "another apply or revert is still running"
    return 1
  fi
  do_revert_internal
  mounts=$(count_mounts)
  log_line "revert: changed=$REVERT_CHANGED mounts=$mounts"
  ntfy_notify "LumaGlass reverted to stock"
  printf '{"ok":true,"applied":false,"mounts":%s}\n' "$mounts"
  return 0
}

# -------------------------------------------------------------------- apply

verb_apply() {
  if ! take_mutation_lock; then
    emit_error "another apply or revert is still running"
    return 1
  fi
  t0=$(date +%s)
  mkdir -p "$STATE" "$BACKUP" 2>/dev/null

  version=$(get_version); [ -n "$version" ] || version="0.0.0"

  # 1. Build/refresh $ASSETS from real stock, never from a merged view.
  need_build=0
  if [ ! -d "$ASSETS" ] || [ ! -d "$ASSETS/i18n" ]; then
    need_build=1
  else
    stamp_epoch=$(mtime_epoch "$STAMP")
    for src in "$HOME_XML_SRC" "$EN_SED_SRC" "$BG_HD_SRC" "$BG_2K_SRC" "$BG_4K_SRC"; do
      s_epoch=$(mtime_epoch "$src")
      if [ "$s_epoch" -gt "$stamp_epoch" ] 2>/dev/null; then need_build=1; fi
    done
  fi

  if [ "$need_build" -eq 1 ]; then
    # Unmount first: if a bind is already active, reading the target now
    # would copy a merged view, never real stock.
    drain_umount "$STOCK_ASSETS"
    rm -rf "$ASSETS.building" 2>/dev/null
    mkdir -p "$ASSETS.building"
    cperr=$( (cd "$STOCK_ASSETS" && cp -R . "$ASSETS.building") 2>&1 >/dev/null )
    cprc=$?
    if [ "$cprc" -ne 0 ]; then
      log_line "apply: failed to copy stock assets: $cperr"
      ntfy_notify "LumaGlass apply failed: could not copy stock assets"
      emit_error "stock asset copy failed: $cperr"
      return 1
    fi
    # i18n is a symlink in real stock; dereference it into a real directory
    # so string overlays land inside the copy, not on the original target.
    if [ -L "$ASSETS.building/i18n" ]; then
      i18n_target=$(readlink "$ASSETS.building/i18n" 2>/dev/null)
      case "$i18n_target" in
        /*) : ;;
        *) i18n_target="$STOCK_ASSETS/$i18n_target" ;;
      esac
      if [ -n "$i18n_target" ] && [ -d "$i18n_target" ]; then
        rm -f "$ASSETS.building/i18n"
        mkdir -p "$ASSETS.building/i18n"
        ( cd "$i18n_target" && cp -R . "$ASSETS.building/i18n" ) 2>/dev/null
      fi
    fi
    # Keep a pristine copy of the stock strings. Every apply regenerates
    # en.json from this, so the greeting cannot freeze at a stale value the
    # way an in-place rewrite would (the sed rules match stock text only).
    if [ -f "$ASSETS.building/i18n/en.json" ]; then
      cp -f "$ASSETS.building/i18n/en.json" "$ASSETS.building/i18n/en.json.stock" 2>/dev/null
    fi
    rm -rf "$ASSETS" 2>/dev/null
    mv "$ASSETS.building" "$ASSETS"
    touch "$STAMP" 2>/dev/null
  fi

  # 2. Overlay payload onto $ASSETS.
  cp -f "$HOME_XML_SRC" "$ASSETS/home.xml" 2>/dev/null

  mkdir -p "$ASSETS/images/hd" "$ASSETS/images/2k" "$ASSETS/images/4k" 2>/dev/null
  cp -f "$BG_HD_SRC" "$ASSETS/images/hd/bg_banner_img.png" 2>/dev/null
  cp -f "$BG_2K_SRC" "$ASSETS/images/2k/bg_banner_img.png" 2>/dev/null
  cp -f "$BG_4K_SRC" "$ASSETS/images/4k/bg_banner_img.png" 2>/dev/null

  # Keep a pristine stock copy and always regenerate from it: rewriting
  # en.json in place would stop matching the stock keys on the second apply.
  # The greeting is owned by the compositor QML, not by these strings.
  if [ ! -f "$ASSETS/i18n/en.json.stock" ] && [ -f "$ASSETS/i18n/en.json" ]; then
    cp -f "$ASSETS/i18n/en.json" "$ASSETS/i18n/en.json.stock" 2>/dev/null
  fi
  if [ -f "$ASSETS/i18n/en.json.stock" ]; then
    sed -f "$EN_SED_SRC" "$ASSETS/i18n/en.json.stock" 2>/dev/null > "$ASSETS/i18n/en.json.tmp.$$" \
      && mv "$ASSETS/i18n/en.json.tmp.$$" "$ASSETS/i18n/en.json"
  fi

  # 3. Stage what this apply would bind, then decide whether anything changed.
  #
  # Draining and re-binding an unchanged set is not harmless: while the binds
  # are down a Home launch reads stock assets, and moving the bind timestamp
  # forward would make the compositor look as if it had read stale content and
  # earn it a restart it does not need. So a set that is byte-identical to
  # what is already live is left exactly as it is.
  fps_now=$(cfg_get_bool fps); [ -n "$fps_now" ] || fps_now=false
  stage_compositor "$fps_now" "$COMPOSITOR_STAGE.next"

  changed=1
  if [ "$(md5sum < "$COMPOSITOR_STAGE.next" 2>/dev/null)" = "$(md5sum < "$COMPOSITOR_STAGE" 2>/dev/null)" ] \
     && [ "$(md5sum < "$WALL_SRC" 2>/dev/null)" = "$(md5sum < "$WALLPAPER_STAGE" 2>/dev/null)" ] \
     && all_binds_live; then
    changed=0
    rm -f "$COMPOSITOR_STAGE.next"
    log_line "apply: staged set unchanged and every bind live, not remounting"
  fi

  if [ "$changed" -eq 1 ]; then
    # Drain any existing binds BEFORE replacing the stage. The staged QML is
    # the source of a live bind after a previous apply, and replacing a bind
    # source in place fails with EBUSY, so unmounting has to come first.
    drain_umount "$QML_TARGET_1"
    drain_umount "$QML_TARGET_2"
    drain_umount "$STOCK_ASSETS"

    # 4. Stage the persistent wallpaper copy and the compositor QML working copy.
    cp -f "$WALL_SRC" "$WALLPAPER_STAGE" 2>/dev/null
    mv -f "$COMPOSITOR_STAGE.next" "$COMPOSITOR_STAGE"

    # 5. Bind each distinct target exactly once.
    resolve_qml_targets
    for t in $qml_targets; do
      binderr=$(mount --bind "$COMPOSITOR_STAGE" "$t" 2>&1 >/dev/null)
      if [ $? -ne 0 ]; then
        log_line "apply: bind failed on $t: $binderr"
        do_revert_internal
        ntfy_notify "LumaGlass apply failed: compositor bind failed"
        emit_error "compositor bind failed: $binderr"
        return 1
      fi
    done

    binderr=$(mount --bind "$ASSETS" "$STOCK_ASSETS" 2>&1 >/dev/null)
    if [ $? -ne 0 ]; then
      log_line "apply: bind failed on assets: $binderr"
      do_revert_internal
      ntfy_notify "LumaGlass apply failed: assets bind failed"
      emit_error "assets bind failed: $binderr"
      return 1
    fi

    # Every intended bind must be live before we touch the compositor.
    for t in $qml_targets "$STOCK_ASSETS"; do
      if ! is_mounted "$t"; then
        log_line "apply: bind verification failed for $t"
        do_revert_internal
        ntfy_notify "LumaGlass apply failed: bind verification failed"
        emit_error "bind verification failed for $t"
        return 1
      fi
    done
    record_bound_now
  fi

  # 6. Restart the compositor only if it needs it.
  #
  # The compositor reads the QML once, at startup. If it started AFTER the
  # content it is showing went live - a no-op re-apply, or a compositor that
  # came up on its own after the binds - it already loaded the modded QML and
  # a restart only blacks the screen for 15s for nothing. On a cold boot it
  # never has: the compositor starts at boot+2s and Homebrew Channel's hooks
  # run at boot+20s, so that path always takes exactly one restart.
  bound_up=$(bound_at_uptime)
  [ -n "$bound_up" ] || { record_bound_now; bound_up=$(bound_at_uptime); }

  restart_needed=1
  start_up=$(surface_start_uptime)
  if [ -z "$start_up" ]; then
    # The compositor is not running, so it will read the modded QML when it
    # next starts.
    restart_needed=0
    log_line "apply: compositor not running, binds staged for its next start"
  elif [ "$start_up" -ge "$bound_up" ] 2>/dev/null; then
    restart_needed=0
    log_line "apply: compositor started at boot+${start_up}s, after binds at boot+${bound_up}s, no restart needed"
  elif ! panel_is_active; then
    # Nothing is being presented, so the next natural compositor start will
    # pick the binds up. Forcing one here races the power transition.
    restart_needed=0
    log_line "apply: panel not active, binds staged for next compositor start"
  else
    log_line "apply: compositor started at boot+${start_up}s, before binds at boot+${bound_up}s, restarting"
  fi

  # 7. Restart if needed, then verify no shader compile failure was logged by
  # the compositor that read this content. The log spans boots and its early
  # lines carry an unsynchronised clock, so the check is anchored on a line
  # count taken just before our restart - never on a timestamp. A compositor
  # we did not restart already passed this check in the apply that stamped
  # the set as verified.
  if [ "$restart_needed" -eq 1 ]; then
    marker=$(wc -l < "$MSGLOG" 2>/dev/null | tr -d ' '); [ -n "$marker" ] || marker=0
    record_bound_now
    if ! restart_surface; then
      log_line "apply: surface-manager-daemon did not come back active"
      do_revert_internal
      ntfy_notify "LumaGlass apply failed: compositor did not restart"
      emit_error "compositor did not become active after restart"
      return 1
    fi
    kill_home_app
    relaunch_home
    if sed -n "$((marker+1)),\$p" "$MSGLOG" 2>/dev/null | grep -qa 'shader compilation failed'; then
      log_line "apply: shader compilation failure detected post-restart, auto-reverting"
      rm -f "$VERIFIED"
      do_revert_internal
      ntfy_notify "LumaGlass apply failed: shader compilation error, auto-reverted to stock"
      emit_error "shader compilation failed; auto-reverted to stock"
      return 1
    fi
  fi
  staged_hash > "$VERIFIED"

  mounts=$(count_mounts)
  took=$(( $(date +%s) - t0 ))
  log_line "apply: success version=$version mounts=$mounts took=${took}s"
  ntfy_notify "LumaGlass applied (v$version)"
  printf '{"ok":true,"applied":true,"mounts":%s,"took":%s}\n' "$mounts" "$took"
  return 0
}

# ---------------------------------------------------------------- boot-bind

verb_boot_bind() {
  # The boot hook's opening move: mount the previous boot's staged set in well
  # under a second, before the ~5s a full apply spends staging.
  #
  # On this firmware that does not avoid the boot restart. The compositor
  # starts at boot+2s and Homebrew Channel's hooks run at boot+20s, so it has
  # always read stock QML by the time anything of ours can run, and /etc is a
  # read-only overlay with no way to order a unit ahead of it. What binding
  # first buys is that the one restart happens as early as the hook allows,
  # and that any compositor start after this point - a crash respawn, a power
  # transition that recycles it - picks the modded QML up with no restart.
  #
  # It only ever binds a set that a full apply has already verified on this
  # firmware, and it skips itself once after a boot that never reported ok.
  if ! take_mutation_lock; then
    emit_error "another apply or revert is still running"
    return 1
  fi
  if [ -f "$BOOT_PENDING" ]; then
    rm -f "$BOOT_PENDING"
    log_line "boot-bind: previous boot never completed, skipping fast path once"
    printf '{"ok":true,"bound":false,"reason":"failsafe"}\n'
    return 0
  fi
  if [ ! -f "$COMPOSITOR_STAGE" ] || [ ! -f "$WALLPAPER_STAGE" ] || [ ! -f "$ASSETS/home.xml" ] || [ ! -d "$ASSETS/i18n" ]; then
    log_line "boot-bind: no staged set, leaving it to apply"
    printf '{"ok":true,"bound":false,"reason":"no-stage"}\n'
    return 0
  fi
  if [ "$(staged_hash)" != "$(cat "$VERIFIED" 2>/dev/null)" ]; then
    log_line "boot-bind: staged set is not the verified one, leaving it to apply"
    printf '{"ok":true,"bound":false,"reason":"unverified"}\n'
    return 0
  fi

  touch "$BOOT_PENDING"
  resolve_qml_targets
  n=0
  for t in $qml_targets; do
    is_mounted "$t" && continue
    mount --bind "$COMPOSITOR_STAGE" "$t" >/dev/null 2>&1 && n=$((n+1))
  done
  if ! is_mounted "$STOCK_ASSETS"; then
    mount --bind "$ASSETS" "$STOCK_ASSETS" >/dev/null 2>&1 && n=$((n+1))
  fi
  if all_binds_live; then
    record_bound_now
    log_line "boot-bind: $n bind(s) made, all live"
    printf '{"ok":true,"bound":true,"mounts":%s}\n' "$(count_mounts)"
  else
    log_line "boot-bind: binds incomplete after $n mount(s), leaving it to apply"
    printf '{"ok":true,"bound":false,"reason":"incomplete"}\n'
  fi
  return 0
}

verb_boot_ok() {
  # Called by the boot hook once the boot's apply reported ok.
  rm -f "$BOOT_PENDING"
  printf '{"ok":true}\n'
  return 0
}

# ------------------------------------------------------------------- status

verb_status() {
  ensure_config
  version=$(get_version); [ -n "$version" ] || version="0.0.0"
  mounts=$(count_mounts)
  if [ "$mounts" -gt 0 ]; then applied=true; else applied=false; fi
  if [ -L "$AUTOSTART_LINK" ]; then persist=true; else persist=false; fi
  fps=$(cfg_get_bool fps); [ "$fps" = "true" ] && fps=true || fps=false
  ntfy_en=$(cfg_get_bool enabled); [ "$ntfy_en" = "true" ] && ntfy_en=true || ntfy_en=false
  ntfy_url_esc=$(json_escape "$(cfg_get_str url)")
  firmware_esc=$(json_escape "$(get_firmware)")
  model_esc=$(json_escape "$(get_model)")
  printf '{"ok":true,"version":"%s","applied":%s,"mounts":%s,"persist":%s,"fps":%s,"ntfy":{"enabled":%s,"url":"%s"},"firmware":"%s","model":"%s"}\n' \
    "$version" "$applied" "$mounts" "$persist" "$fps" "$ntfy_en" "$ntfy_url_esc" "$firmware_esc" "$model_esc"
  return 0
}

# ------------------------------------------------------------------ persist

verb_persist() {
  action="${1:-}"
  case "$action" in
    on)
      mkdir -p "$(dirname "$AUTOSTART_LINK")" 2>/dev/null
      rm -f "$AUTOSTART_LINK" 2>/dev/null
      if ! ln -s "$AUTOSTART_SRC" "$AUTOSTART_LINK" 2>/dev/null; then
        emit_error "failed to create persist symlink"
        return 1
      fi
      set_cfg_bool persist true
      ;;
    off)
      rm -f "$AUTOSTART_LINK" 2>/dev/null
      set_cfg_bool persist false
      ;;
    *)
      emit_error "persist requires on or off"
      return 1
      ;;
  esac
  if [ -L "$AUTOSTART_LINK" ]; then real=true; else real=false; fi
  log_line "persist: set to $action (symlink=$real)"
  printf '{"ok":true,"persist":%s}\n' "$real"
  return 0
}

# ---------------------------------------------------------------------- fps

verb_fps() {
  action="${1:-}"
  case "$action" in
    on) val=true ;;
    off) val=false ;;
    *) emit_error "fps requires on or off"; return 1 ;;
  esac
  set_cfg_bool fps "$val"
  # The overlay is a property in the staged QML, so flipping it is a re-apply:
  # apply sees the staged set change, rebinds once per distinct target, takes
  # the mutation lock, and runs the shader verification. The old inline
  # version bound both QML paths - the same inode - and stacked two mounts.
  if [ "$(count_mounts)" -gt 0 ]; then
    if ! verb_apply >/dev/null; then
      emit_error "fps set, but re-apply failed; see log"
      return 1
    fi
  fi
  log_line "fps: set to $val"
  printf '{"ok":true,"fps":%s}\n' "$val"
  return 0
}

# --------------------------------------------------------------------- ntfy

verb_ntfy() {
  action="${1:-}"
  case "$action" in
    set)
      url="${2:-}"
      case "$url" in
        http://*/*|https://*/*) : ;;
        *) emit_error "ntfy url must be http(s) with a topic path"; return 1 ;;
      esac
      set_cfg_ntfy_url "$url"
      set_cfg_bool enabled true
      log_line "ntfy: configured"
      ;;
    off)
      set_cfg_bool enabled false
      log_line "ntfy: disabled"
      ;;
    test)
      cfg_read_all
      if [ "$CFG_NTFY_ENABLED" != "true" ] || [ -z "$CFG_NTFY_URL" ]; then
        emit_error "ntfy is not configured"
        return 1
      fi
      if ! curl -fsS -m 10 -H 'Title: LumaGlass' -H 'Tags: tv' -d 'LumaGlass test notification' "$CFG_NTFY_URL" >/dev/null 2>&1; then
        log_line "ntfy: test delivery failed"
        emit_error "ntfy test failed to deliver"
        return 1
      fi
      log_line "ntfy: test delivered"
      ;;
    *)
      emit_error "ntfy requires set <url>, off, or test"
      return 1
      ;;
  esac
  cfg_read_all
  url_esc=$(json_escape "$CFG_NTFY_URL")
  printf '{"ok":true,"ntfy":{"enabled":%s,"url":"%s"}}\n' "$CFG_NTFY_ENABLED" "$url_esc"
  return 0
}

# ---------------------------------------------------------------------- log

verb_log() {
  n="${1:-}"
  case "$n" in ''|*[!0-9]*) n=20 ;; esac
  mkdir -p "$STATE" 2>/dev/null
  touch "$LOGFILE" 2>/dev/null
  out=""
  while IFS= read -r line || [ -n "$line" ]; do
    esc=$(json_escape "$line")
    if [ -z "$out" ]; then out="\"$esc\""; else out="$out,\"$esc\""; fi
  done <<LGEOF
$(tail -n "$n" "$LOGFILE" 2>/dev/null)
LGEOF
  printf '{"ok":true,"lines":[%s]}\n' "$out"
  return 0
}

# ------------------------------------------------------------------ version

verb_version() {
  v=$(get_version); [ -n "$v" ] || v="0.0.0"
  printf '{"ok":true,"version":"%s"}\n' "$v"
  return 0
}

# ------------------------------------------------------------------- dispatch

ensure_config

case "$VERB" in
  status) verb_status; exit $? ;;
  apply) verb_apply; exit $? ;;
  boot-bind) verb_boot_bind; exit $? ;;
  boot-ok) verb_boot_ok; exit $? ;;
  revert) verb_revert; exit $? ;;
  persist) verb_persist "${2:-}"; exit $? ;;
  fps) verb_fps "${2:-}"; exit $? ;;
  ntfy) verb_ntfy "${2:-}" "${3:-}"; exit $? ;;
  log) verb_log "${2:-}"; exit $? ;;
  version) verb_version; exit $? ;;
  *) emit_error "unknown verb: $VERB"; exit 1 ;;
esac
