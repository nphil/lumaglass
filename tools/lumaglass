#!/bin/sh
# LumaGlass on-device engine (POSIX sh / busybox ash only).
#
# Verb map (each verb prints exactly one JSON object on stdout, exit 0/nonzero):
#   status                 -> current measured state
#   apply                  -> stage the mod, point the compositor at it, relaunch Home
#   revert                 -> drop the env override, unbind, restore icons, back to stock
#   persist on|off         -> toggle the boot-hook symlink in webosbrew init.d
#   fps on|off             -> toggle the compositor FPS debug overlay
#   standby warm|cold      -> Quick Start+ on with webos-sddp off, or fully off
#   ntfy set <url>|off|test -> configure/test ntfy.sh notifications
#   log [n]                -> last n log lines (default 20)
#   version                -> version string from appinfo.json
#
# Nothing is ever written outside $APPDIR, $STATE (/var/lib/lumaglass), and
# /var/lib/webosbrew/init.d/50-lumaglass.

set -u

APPDIR=$(cd "$(dirname "$0")/.." && pwd)
STATE=/var/lib/lumaglass
CONFIG="$STATE/config.json"
LOGFILE="$STATE/log"
ASSETS="$STATE/assets"
BACKUP="$STATE/backup"
STAMP="$STATE/.built-stamp"
COMPOSITOR_STAGE="$STATE/compositor.qml"
WALLPAPER_STAGE="$STATE/wall_1080.png"
# Written by the last full apply that passed verification: a hash of the staged
# set. boot-bind only fast-binds a set that carries this stamp.
VERIFIED="$STATE/.verified"
# Epoch at which the current staged content became live. Survives a re-apply
# that changes nothing, so the compositor can be judged against the real time
# the content it read was bound, not the time of the latest no-op apply.
BOUND_AT="$STATE/.bound-at"
# Present from boot-bind until the boot's apply reports ok. Found at the next
# boot, it means the previous one never completed, and the fast path is skipped
# once - the same shape as Homebrew Channel's own failsafe.
BOOT_PENDING="$STATE/.boot-pending"

APPINFO="$APPDIR/appinfo.json"
QML_SRC="$APPDIR/payload/compositor/StarfishFullscreenContainer.qml"
HOME_XML_SRC="$APPDIR/payload/home/home.xml"
EN_SED_SRC="$APPDIR/payload/home/en.json.sed"
WALL_SRC="$APPDIR/payload/wallpaper/wall_1080.png"
BG_HD_SRC="$APPDIR/payload/wallpaper/bg_hd.png"
BG_2K_SRC="$APPDIR/payload/wallpaper/bg_2k.png"
BG_4K_SRC="$APPDIR/payload/wallpaper/bg_4k.png"

# The compositor resolves QML modules through QML2_IMPORT_PATH, and its unit
# reads an optional environment file from /var - which is writable and
# persistent. So instead of bind-mounting our QML over the read-only module in
# /usr, we keep a full shadow copy of the WebOSCompositor module with our file
# swapped in, and point the import path at it. Nothing of ours is mounted over
# /usr, which is an overlay with lowerdir only and can never be written.
#
# The compositor's first start can never load the modded QML, and the reason
# is not the import path but the filesystem: until
# mount-readwrite.service (12.96s measured) relocates it, /var does not show
# the writable ext4 subtree at all, so /var/systemd/system/env is simply not
# a path that exists yet. surface-manager-daemon starts at 2.63s, its
# EnvironmentFile is optional, and the read is therefore a silent no-op - the
# file's atime is untouched across a boot, and LG's own env files for
# ls-hubd, configd, memchute, tvpowerd, bootd and sam are equally inert that
# early. Every restart after ~13s picks the file up reliably.
#
# So one compositor restart per boot is structural, not a bug to be fixed:
# apply forces it whenever the running compositor lacks the shadow. What can
# be bought is when it happens - see the early boot hook below.
#
# A compositor restart is not just a visible flash. It makes LG's igallery
# preview segfault in QFontDatabase::removeAllApplicationFonts (reproducible
# on stock firmware with no mod present), faultmanager records the crash with
# recovery rebootToSuspend, and tvpowerd then answers the next power-off with
# a full reboot into standby instead of switching off. Since the restart has
# not been eliminated, what keeps power-off immediate is restart_surface
# removing the crash reports its own restart produced.
STOCK_QML_MODULE=/usr/lib/qt5/qml/WebOSCompositor
MODULE_RELPATH=views/fullscreen/StarfishFullscreenContainer.qml
SHADOW_ROOT="$STATE/qml"
SHADOW_MODULE="$SHADOW_ROOT/WebOSCompositor"
SHADOW_QML="$SHADOW_MODULE/$MODULE_RELPATH"
# Fingerprint of the stock module the shadow was built from. A firmware update
# replaces the stock module; a shadow built from the old one would then feed
# stale QML to new libraries, so the hook rebuilds whenever this stops
# matching, and falls back to stock if it cannot.
SHADOW_STOCK_FP="$STATE/.shadow-stock"
# Fingerprint of the shadow tree itself, recorded once it is fully built.
# /var is ext4 data=ordered: directory entries are journalled, file contents
# are not. A power cut between renaming the shadow into place and its data
# reaching disk leaves a module with every file present and most of them
# truncated - 318 files holding 212KB instead of 2030741 bytes, observed. The
# compositor then starts on it, resolves nothing and presents a black screen,
# so integrity has to be checked against this, not just the one file we inject.
SHADOW_SELF_FP="$STATE/.shadow-self"
ENV_DIR=/var/systemd/system/env
ENV_FILE="$ENV_DIR/surface-manager.env"
STOCK_ASSETS=/usr/palm/applications/com.webos.app.home/data/flutter_assets/assets

HOME_PKILL_PATTERN="flutter-client -i com.webos.app.home"
HOME_LAUNCH_URI="luna://com.webos.applicationManager/launch"
HOME_LAUNCH_PARAMS='{"id":"com.webos.app.home"}'
SURFACE_SVC=surface-manager-daemon.service
MSGLOG=/var/log/messages
# A compositor that reports active is not yet presenting. Every cheap signal -
# is-active, the Home process, getForegroundAppInfo, NL_HOME_SHOWN - goes true
# about 8s before anything reaches the panel, so readiness is taken from the
# panel itself: capture a small frame and look at how much PNG came back.
# Measured on webOS 10.2.1 at 320x180: 835 bytes while the panel is still
# blank, >79000 once Home is composited.
CAPTURE_URI="luna://com.webos.service.capture/executeOneShot"
CAP_TMP=/tmp/lumaglass-ready.png
CAP_BLANK_BYTES=4096
READY_WAIT=30
SCREEN_ON_URI="luna://com.webos.service.tvpower/power/turnOnScreen"
AUTOSTART_LINK=/var/lib/webosbrew/init.d/50-lumaglass
AUTOSTART_SRC="$APPDIR/tools/autostart.sh"

# Early boot hook.
#
# Homebrew Channel's init.d run-parts is the obvious place to apply from, but
# it fires at ~33s, long after the panel is live, which is what made a boot
# show stock Home, blink, and only then the mod. The earliest a root
# customization can do anything useful is just after mount-readwrite.service
# (12.96s measured), because until then /var shows the firmware's near-empty
# var, not the writable one: that is also why the compositor's own
# EnvironmentFile cannot work at its first start (2.6s) - the file is simply
# not visible on that path yet, so systemd's optional read is a no-op.
#
# kdump.service is the hook: it starts at 14.27s, right inside that window, it
# reads an EnvironmentFile under /var so PATH can be set for it, and its
# script's first act is a bare `grep`. On a set without `crashkernel` on the
# kernel command line - this one - the script is a no-op that exits 0, and the
# unit is Restart=no, so shadowing one command in it costs nothing. The shim
# always exec's the real grep, so a broken shim cannot stop the unit.
EARLY_ENV_FILE=/var/systemd/system/env/kdump.env
EARLY_BIN="$STATE/earlybin"
EARLY_SHIM="$EARLY_BIN/grep"
EARLY_ONCE=/tmp/.lumaglass-early-done
LOCKFILE=/var/lib/lumaglass/mutate.lock
# Seconds a second mutation waits for the first to finish. An apply takes ~30s
# at worst, so this is generous without hanging a caller forever.
LOCK_WAIT=180

VERB="${1:-}"

# ---------------------------------------------------------------- utilities

json_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr '\n\r\t' '   '
}

emit_error() {
  msg=$(json_escape "$1")
  printf '{"ok":false,"error":"%s"}\n' "$msg"
}

mtime_epoch() {
  date -r "$1" +%s 2>/dev/null || echo 0
}

log_line() {
  mkdir -p "$STATE" 2>/dev/null
  ts=$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)
  msg=$(printf '%s' "$1" | tr '\n' ' ')
  printf '%s %s\n' "$ts" "$msg" >> "$LOGFILE" 2>/dev/null
  if [ -f "$LOGFILE" ]; then
    lc=$(wc -l < "$LOGFILE" 2>/dev/null | tr -d ' ')
    [ -n "$lc" ] || lc=0
    if [ "$lc" -gt 200 ] 2>/dev/null; then
      tail -n 200 "$LOGFILE" > "$LOGFILE.trim.$$" 2>/dev/null && mv "$LOGFILE.trim.$$" "$LOGFILE"
    fi
  fi
}

# ------------------------------------------------------------- mount helpers

is_mounted() {
  # $1 = exact absolute target path. Matches only the literal bind target,
  # never the dozens of per-app jail mirrors webOS maintains at paths like
  # /mnt/lg/*/var/palm/jail/<app>/usr/lib/qml/... which also contain the
  # same suffix and would otherwise inflate the count.
  mount 2>/dev/null | grep -qF -- " on $1 type "
}

count_mounts() {
  # Only Home's assets are bound now; the compositor QML arrives through the
  # import path, which is not a mount.
  n=0
  is_mounted "$STOCK_ASSETS" && n=$((n+1))
  echo "$n"
}

drain_umount() {
  while umount "$1" >/dev/null 2>&1; do :; done
}

# ------------------------------------------------------------- luna helpers

kill_home_app() {
  # Safe by construction: this exact pattern is the Home flutter client's own
  # process command line, never a substring of this script's own invocation.
  pkill -f "$HOME_PKILL_PATTERN" >/dev/null 2>&1
  return 0
}

home_running() {
  # Home runs in its own namespace, where busybox `ps` cannot see it: `ps`
  # reports zero flutter-client processes while the app is demonstrably
  # running and on screen. Scan /proc/*/cmdline instead, and anchor on the
  # binary path so this never matches a shell that merely mentions the app id
  # on its own command line.
  for p in /proc/[0-9]*; do
    c=$(tr '\0' ' ' < "$p/cmdline" 2>/dev/null)
    case "$c" in
      /usr/bin/flutter-client*com.webos.app.home*) return 0 ;;
    esac
  done
  return 1
}

panel_presenting() {
  # Whether anything is actually on the panel, asked of the panel itself.
  b=$(luna-send -n 1 "$CAPTURE_URI" \
        "{\"path\":\"$CAP_TMP\",\"method\":\"DISPLAY\",\"format\":\"PNG\",\"width\":320,\"height\":180}" \
        2>/dev/null | tr ',' '\n' | grep writtenBytes | tr -dc '0-9')
  [ -n "$b" ] || return 1
  [ "$b" -gt "$CAP_BLANK_BYTES" ]
}

wait_presenting() {
  # Bounded wait for real pixels. Returns 1 on timeout so the caller can say
  # so, but a timeout is not an error: a boot into standby never presents.
  # Deliberately not `i`: this runs inside relaunch_home's own loop, and sh
  # has no locals, so sharing the name ended that loop early and logged a
  # nonsense attempt count.
  waited=0
  while [ "$waited" -lt "$READY_WAIT" ]; do
    panel_presenting && return 0
    sleep 1
    waited=$((waited+1))
  done
  return 1
}

relaunch_home() {
  # One launch, then wait for pixels.
  #
  # Hammering launch requests every couple of seconds while the compositor is
  # still coming up leaves the panel black indefinitely, so there is still
  # exactly one launch per attempt. What changed is the gate: the Home
  # process, NL_HOME_SHOWN and getForegroundAppInfo all go true about 8s
  # before anything is composited, so none of them can end the wait, but a
  # captured frame can. Measured: content reaches the panel 12s after a
  # restart, and launching Home immediately does not delay it - the old
  # sequence slept 14s before even asking for Home, then slept 8s more.
  #
  # turnOnScreen exists for the interactive path: a compositor restart can
  # leave the panel blanked, and the user asked for the screen. On the boot
  # path it is wrong: after a crash-recovery "reboot to suspend" the set is
  # booting in order to go back to standby, and forcing the panel on here
  # turned a TV the user had switched off back on. The hook sets
  # LUMAGLASS_BOOT=1; the panel is then whatever the system decided.
  i=0
  while [ "$i" -lt 3 ]; do
    [ "${LUMAGLASS_BOOT:-0}" = "1" ] || luna-send -n 1 "$SCREEN_ON_URI" '{}' >/dev/null 2>&1
    luna-send -n 1 "$HOME_LAUNCH_URI" "$HOME_LAUNCH_PARAMS" >/dev/null 2>&1
    if wait_presenting; then
      log_line "home on panel after $i relaunch attempt(s)"
      return 0
    fi
    if home_running; then
      # Running but nothing on the panel: the set is booting into standby, or
      # the panel is off. Nothing more to wait for.
      log_line "home up after $i relaunch attempt(s), panel not presenting"
      return 0
    fi
    i=$((i+1))
  done
  log_line "home did not come back after 3 launch attempts"
  return 1
}

wait_surface_active() {
  # Bounded poll (~40s) for surface-manager-daemon.service to report active.
  i=0
  while [ "$i" -lt 40 ]; do
    st=$(systemctl is-active "$SURFACE_SVC" 2>/dev/null)
    if [ "$st" = "active" ]; then return 0; fi
    sleep 1
    i=$((i+1))
  done
  return 1
}

restart_surface() {
  # A restart is how the modded QML reaches the screen: the compositor's first
  # start at 2.6s cannot see our EnvironmentFile, because /var does not yet
  # show the writable filesystem that early. It makes LG stock apps segfault
  # on teardown and arms tvpowerd's reboot-to-suspend, so snapshot the crash
  # reports first and remove the ones this restart adds.
  #
  # No settle here. is-active goes true almost immediately (Type=notify), long
  # before a frame can be presented, but the caller launches Home straight
  # away and then waits on the panel, which is the only honest gate. Measured:
  # asking for Home at +4s still put content up at +12s, so sleeping first
  # bought nothing and cost 14s.
  reports_before=$(snapshot_reports)
  systemctl restart "$SURFACE_SVC" >/dev/null 2>&1
  wait_surface_active || return 1
  disarm_restart_crashes "$reports_before"
  return 0
}

home_back_after_restart() {
  # Home after a compositor restart, then a second sweep of the crash reports.
  # The igallery teardown crash lands ~3s after the restart, which is inside
  # the window wait_surface_active can return in, so the sweep inside
  # restart_surface may run before there is anything to remove. By the time
  # Home is on the panel (~12s) it has landed.
  kill_home_app
  relaunch_home
  disarm_restart_crashes "$reports_before"
}

surface_start_uptime() {
  # Seconds after boot at which the running compositor started, from field 22
  # of /proc/<pid>/stat (clock ticks since boot, CLK_TCK=100 on this kernel).
  #
  # Not /proc/<pid>'s mtime. That is only the time the /proc entry was last
  # instantiated - on this kernel it read "176s ago" for a compositor that
  # had been running for 829s - and trusting it made apply skip a restart the
  # compositor needed, leaving stock QML under a modded layout.
  #
  # Monotonic on purpose: the wall clock is unsynchronised for the first
  # seconds of boot (systemd stamps early units in 2022), so any comparison in
  # epoch seconds across that window is meaningless.
  p=$(pgrep -x surface-manager 2>/dev/null | head -n1)
  [ -n "$p" ] || return 1
  t=$(awk '{print int($22 / 100)}' "/proc/$p/stat" 2>/dev/null)
  [ -n "$t" ] || return 1
  printf '%s\n' "$t"
}

boot_id() { cat /proc/sys/kernel/random/boot_id 2>/dev/null; }
uptime_s() { cut -d. -f1 /proc/uptime 2>/dev/null; }

record_bound_now() {
  # The content now live was bound at this instant of this boot. Scoped to the
  # boot id so a stale record from a previous boot can never be mistaken for
  # this one's.
  printf '%s %s\n' "$(boot_id)" "$(uptime_s)" > "$BOUND_AT"
}

bound_at_uptime() {
  # Seconds after boot the live content was bound, or nothing if the record is
  # missing or from another boot.
  read -r bid up < "$BOUND_AT" 2>/dev/null || return 1
  [ "$bid" = "$(boot_id)" ] || return 1
  printf '%s\n' "$up"
}

panel_is_active() {
  # Only "Active" means the panel is actually presenting. Restarting the
  # compositor while the set is in standby or suspending is pointless work on
  # the boot path, and it is how a half-finished apply used to be interrupted.
  luna-send -n 1 luna://com.webos.service.tvpower/power/getPowerState '{}' 2>/dev/null \
    | tr -d '\n' | grep -q '"state"[[:space:]]*:[[:space:]]*"Active"'
}

take_mutation_lock() {
  # Serialise anything that mounts, unmounts or restarts the compositor. Two
  # concurrent applies interleave their unmount/stage/bind steps and can leave
  # the wrong number of mounts live; the boot hook made this reachable, because
  # a user launching the app can now overlap the detached boot apply.
  mkdir -p "$(dirname "$LOCKFILE")" 2>/dev/null
  exec 9>"$LOCKFILE" 2>/dev/null || return 0
  if ! flock -x -w "$LOCK_WAIT" 9 2>/dev/null; then
    return 1
  fi
  return 0
}

# --------------------------------------------------------------- config i/o

write_config() {
  # $1=fps $2=persist $3=ntfy_enabled $4=ntfy_url $5=sddp_prev
  # (fps/persist/enabled: true|false; sddp_prev: on|off|empty)
  mkdir -p "$STATE" 2>/dev/null
  url_esc=$(json_escape "$4")
  sddp_esc=$(json_escape "${5:-}")
  tmp="$CONFIG.tmp.$$"
  printf '{"fps":%s,"ntfy":{"url":"%s","enabled":%s},"persist":%s,"sddp_prev":"%s"}\n' \
    "$1" "$url_esc" "$3" "$2" "$sddp_esc" > "$tmp" && mv "$tmp" "$CONFIG"
}

ensure_config() {
  [ -f "$CONFIG" ] || write_config false false false "" ""
}

cfg_get_bool() {
  # $1 = key name (fps|persist|enabled)
  sed -n "s/.*\"$1\"[ ]*:[ ]*\\(true\\|false\\).*/\\1/p" "$CONFIG" 2>/dev/null | head -n1
}

cfg_get_str() {
  # $1 = key name (url)
  sed -n "s/.*\"$1\"[ ]*:[ ]*\"\\([^\"]*\\)\".*/\\1/p" "$CONFIG" 2>/dev/null | head -n1
}

cfg_read_all() {
  ensure_config
  CFG_FPS=$(cfg_get_bool fps); [ -n "$CFG_FPS" ] || CFG_FPS=false
  CFG_PERSIST=$(cfg_get_bool persist); [ -n "$CFG_PERSIST" ] || CFG_PERSIST=false
  CFG_NTFY_ENABLED=$(cfg_get_bool enabled); [ -n "$CFG_NTFY_ENABLED" ] || CFG_NTFY_ENABLED=false
  CFG_NTFY_URL=$(cfg_get_str url)
  # What enableSDDP was before `standby warm` turned it off, so `standby cold`
  # can put it back. Empty when this mod has not touched it.
  CFG_SDDP_PREV=$(cfg_get_str sddp_prev)
}

set_cfg_bool() {
  # $1 = fps|persist|enabled  $2 = true|false
  cfg_read_all
  case "$1" in
    fps) CFG_FPS="$2" ;;
    persist) CFG_PERSIST="$2" ;;
    enabled) CFG_NTFY_ENABLED="$2" ;;
  esac
  write_config "$CFG_FPS" "$CFG_PERSIST" "$CFG_NTFY_ENABLED" "$CFG_NTFY_URL" "$CFG_SDDP_PREV"
}

set_cfg_ntfy_url() {
  cfg_read_all
  CFG_NTFY_URL="$1"
  write_config "$CFG_FPS" "$CFG_PERSIST" "$CFG_NTFY_ENABLED" "$CFG_NTFY_URL" "$CFG_SDDP_PREV"
}

set_cfg_sddp_prev() {
  cfg_read_all
  CFG_SDDP_PREV="$1"
  write_config "$CFG_FPS" "$CFG_PERSIST" "$CFG_NTFY_ENABLED" "$CFG_NTFY_URL" "$CFG_SDDP_PREV"
}

# ----------------------------------------------------------------- ntfy i/o

ntfy_notify() {
  # $1 = message. Always non-fatal: never propagates a failure to the caller.
  msg="$1"
  cfg_read_all
  [ "$CFG_NTFY_ENABLED" = "true" ] || return 0
  [ -n "$CFG_NTFY_URL" ] || return 0
  curl -fsS -m 10 -H 'Title: LumaGlass' -H 'Tags: tv' -d "$msg" "$CFG_NTFY_URL" >/dev/null 2>&1
  return 0
}

# ---------------------------------------------------------- system readouts

get_version() {
  sed -n 's/.*"version"[ ]*:[ ]*"\([^"]*\)".*/\1/p' "$APPINFO" 2>/dev/null | head -n1
}

get_firmware() {
  if [ -r /etc/os-release ]; then
    v=$(sed -n 's/^VERSION_ID=\(.*\)$/\1/p' /etc/os-release 2>/dev/null | head -n1 | tr -d '"')
    if [ -n "$v" ]; then printf '%s' "$v"; return 0; fi
  fi
  if [ -r /etc/starfish-release ]; then
    v=$(sed -n 's/^[A-Za-z]* release \([0-9.]*\).*/\1/p' /etc/starfish-release 2>/dev/null | head -n1)
    if [ -n "$v" ]; then printf '%s' "$v"; return 0; fi
  fi
  printf '%s' ""
}

get_model() {
  if [ -r /etc/prefs/properties/machineName ]; then
    tr -d '\n' < /etc/prefs/properties/machineName 2>/dev/null
    return 0
  fi
  printf '%s' ""
}

# ------------------------------------------------------------- QML staging

stage_compositor() {
  # $1 = fps (true|false), $2 = output path (default: the live stage). Always
  # rebuilt from the pristine payload, so the payload itself is never touched
  # and repeated calls are idempotent.
  fps="$1"; out="${2:-$COMPOSITOR_STAGE}"
  mkdir -p "$STATE" 2>/dev/null
  sed -e "s#file:///tmp/hx/wall_1080\\.png#file://$WALLPAPER_STAGE#" \
      -e "s/property bool debugFps: true/property bool debugFps: $fps/" \
      "$QML_SRC" > "$out.tmp.$$" && mv "$out.tmp.$$" "$out"
}

staged_hash() {
  # Identity of the whole staged set: everything a bind exposes to the
  # compositor and to Home.
  cat "$COMPOSITOR_STAGE" "$WALLPAPER_STAGE" "$ASSETS/home.xml" "$ASSETS/i18n/en.json" 2>/dev/null | md5sum | cut -c1-32
}

stock_module_fp() {
  # Identity of the stock module as installed: the recursive listing, which
  # carries every file's name, size and mtime. A firmware update rewrites the
  # tree and that shows up here, so there is no need to hash 2.8MB of content
  # on every boot.
  #
  # Not `find -printf`: this is busybox 1.35 find, which does not have it, and
  # the failure was silent - the pipeline hashed empty input, so every
  # fingerprint compared equal to every other and the staleness check could
  # never fire. Verified: `ls -lnR` is stable across calls (412 lines here)
  # and differs as soon as any file's size changes.
  ls -lnR "$STOCK_QML_MODULE" 2>/dev/null | md5sum | cut -c1-32
}

shadow_self_fp() {
  # Identity of the shadow tree. The listing carries every file's size, so a
  # truncated copy fails this even though the file is present.
  ls -lnR "$SHADOW_ROOT" 2>/dev/null | md5sum | cut -c1-32
}

build_shadow() {
  # Rebuild the shadow module from the stock one, swap our staged QML into it,
  # and record both what it was built from and what it now contains. Built
  # beside the live copy and renamed in, so a compositor starting mid-build
  # never sees a half-copied module.
  [ -d "$STOCK_QML_MODULE" ] || return 1
  [ -f "$COMPOSITOR_STAGE" ] || return 1
  rm -rf "$SHADOW_ROOT.next" 2>/dev/null
  mkdir -p "$SHADOW_ROOT.next" 2>/dev/null || return 1
  cp -a "$STOCK_QML_MODULE" "$SHADOW_ROOT.next/" 2>/dev/null || { rm -rf "$SHADOW_ROOT.next"; return 1; }
  cp -f "$COMPOSITOR_STAGE" "$SHADOW_ROOT.next/WebOSCompositor/$MODULE_RELPATH" 2>/dev/null || { rm -rf "$SHADOW_ROOT.next"; return 1; }

  # Get the contents on disk BEFORE the rename publishes them. /var is ext4
  # data=ordered, so without this a power cut can commit the directory entries
  # and lose the data, leaving a complete-looking module full of truncated
  # files that the compositor will happily start on and render nothing from.
  sync

  rm -rf "$SHADOW_ROOT.old" 2>/dev/null
  [ -d "$SHADOW_ROOT" ] && mv "$SHADOW_ROOT" "$SHADOW_ROOT.old"
  mv "$SHADOW_ROOT.next" "$SHADOW_ROOT" || { [ -d "$SHADOW_ROOT.old" ] && mv "$SHADOW_ROOT.old" "$SHADOW_ROOT"; return 1; }
  rm -rf "$SHADOW_ROOT.old" 2>/dev/null
  stock_module_fp > "$SHADOW_STOCK_FP"
  shadow_self_fp > "$SHADOW_SELF_FP"
  sync
  return 0
}

shadow_current() {
  # Usable means all three: it still holds exactly the staged QML, it is
  # byte-for-byte the tree we published, and it was built from the stock
  # module installed right now.
  [ -f "$SHADOW_QML" ] || return 1
  [ "$(md5sum < "$SHADOW_QML" 2>/dev/null)" = "$(md5sum < "$COMPOSITOR_STAGE" 2>/dev/null)" ] || return 1
  [ "$(cat "$SHADOW_SELF_FP" 2>/dev/null)" = "$(shadow_self_fp)" ] || return 1
  [ "$(cat "$SHADOW_STOCK_FP" 2>/dev/null)" = "$(stock_module_fp)" ] || return 1
  return 0
}

env_line() { printf 'QML2_IMPORT_PATH=%s:/usr/lib/qt5/qml\n' "$SHADOW_ROOT"; }

env_live() { [ "$(cat "$ENV_FILE" 2>/dev/null)" = "$(env_line)" ]; }

write_env() {
  mkdir -p "$ENV_DIR" 2>/dev/null || return 1
  env_live && return 0
  env_line > "$ENV_FILE.tmp.$$" && mv -f "$ENV_FILE.tmp.$$" "$ENV_FILE"
}

remove_env() { rm -f "$ENV_FILE" "$ENV_FILE.tmp."* 2>/dev/null; return 0; }

compositor_has_shadow() {
  # Whether the running compositor was started with our import path. Only its
  # own environment says so; the env file on disk says what the NEXT one gets.
  p=$(pgrep -x surface-manager 2>/dev/null | head -n1)
  [ -n "$p" ] || return 1
  tr '\0' '\n' < "/proc/$p/environ" 2>/dev/null | grep -qF "QML2_IMPORT_PATH=$SHADOW_ROOT:"
}

all_binds_live() {
  is_mounted "$STOCK_ASSETS"
}

REPORTS_DIR=/tmp/var/log/reports/librdx

snapshot_reports() {
  # Paths of crash reports present now, one per line, so the ones a compositor
  # restart of ours creates can be told apart from anything already there.
  # Pathname expansion, never `ls`: see disarm_restart_crashes.
  for f in "$REPORTS_DIR"/*; do
    [ -e "$f" ] && printf '%s\n' "$f"
  done
}

disarm_restart_crashes() {
  # $1 = snapshot_reports output taken before the restart.
  #
  # A compositor restart makes LG's inputcommon segfault on teardown
  # (QFontDatabase::removeAllApplicationFonts; reproducible on stock firmware,
  # see the constants block). faultmanager scans this directory at power-off,
  # and any report there makes it answer the suspend request with
  # rebootToSuspend: the set then reboots instead of settling into active
  # standby, and the next power-on is a full boot rather than an instant one.
  # The reports are tmpfs and gone at the next boot anyway; removing only the
  # ones this restart produced gives the power path back without hiding
  # anything that was already there.
  #
  # The names cannot go through `ls`, and not only because they contain
  # spaces: rdxd writes the crashing binary's path into the name with 0x02 in
  # place of each '/', and busybox ls prints those bytes as '?'. A name read
  # back from ls therefore never matches the file, -e is false, rm is a no-op,
  # and the report stays. Pathname expansion hands back the raw bytes.
  before="$1"
  n=0
  for f in "$REPORTS_DIR"/*; do
    [ -e "$f" ] || continue
    printf '%s\n' "$before" | grep -qxF -- "$f" && continue
    rm -f "$f" 2>/dev/null && n=$((n+1))
  done
  [ "$n" -gt 0 ] && log_line "disarmed $n crash report(s) produced by our compositor restart"
  return 0
}

# ------------------------------------------------------------------- revert

do_revert_internal() {
  # Mechanics only; never prints. Sets REVERT_CHANGED=1 if anything was
  # actually mounted or restored, so callers can decide whether a disruptive
  # compositor restart / Home relaunch is warranted.
  REVERT_CHANGED=0

  # The env file is what makes a starting compositor load our module, so it
  # goes first: from that point on any compositor start is stock, whether or
  # not the restart below succeeds.
  if [ -f "$ENV_FILE" ]; then REVERT_CHANGED=1; fi
  remove_env
  # Nothing of ours should run on the boot path after a revert, including the
  # PATH shim kdump.service would otherwise resolve.
  remove_early_hook
  if [ -d "$SHADOW_ROOT" ]; then REVERT_CHANGED=1; fi
  rm -rf "$SHADOW_ROOT" "$SHADOW_ROOT.next" "$SHADOW_ROOT.old" 2>/dev/null
  rm -f "$SHADOW_STOCK_FP" "$SHADOW_SELF_FP" 2>/dev/null

  if is_mounted "$STOCK_ASSETS"; then REVERT_CHANGED=1; fi
  drain_umount "$STOCK_ASSETS"

  # Restore any icon appinfo.json backups generically: each backup's
  # destination path is recorded in a sidecar .origpath file so revert never
  # has to guess an app-id-to-path convention.
  if [ -d "$BACKUP" ]; then
    for origfile in "$BACKUP"/*.origpath; do
      [ -e "$origfile" ] || continue
      base=${origfile%.origpath}
      content="$base.appinfo.json"
      [ -f "$content" ] || continue
      destpath=$(cat "$origfile" 2>/dev/null)
      if [ -n "$destpath" ]; then
        if cp -f "$content" "$destpath" 2>/dev/null; then
          rm -f "$content" "$origfile"
          REVERT_CHANGED=1
        fi
      fi
    done
  fi

  # Nothing of ours is live any more, so the next apply must not inherit the
  # old bind time and skip a restart the compositor genuinely needs.
  rm -f "$BOUND_AT" "$BOOT_PENDING"

  if [ "$REVERT_CHANGED" -eq 1 ]; then
    restart_surface >/dev/null 2>&1
    home_back_after_restart
  fi
  return 0
}

verb_revert() {
  if ! take_mutation_lock; then
    emit_error "another apply or revert is still running"
    return 1
  fi
  do_revert_internal
  mounts=$(count_mounts)
  log_line "revert: changed=$REVERT_CHANGED mounts=$mounts"
  ntfy_notify "LumaGlass reverted to stock"
  printf '{"ok":true,"applied":false,"mounts":%s}\n' "$mounts"
  return 0
}

# -------------------------------------------------------------------- apply

verb_apply() {
  if ! take_mutation_lock; then
    emit_error "another apply or revert is still running"
    return 1
  fi
  t0=$(date +%s)
  mkdir -p "$STATE" "$BACKUP" 2>/dev/null

  version=$(get_version); [ -n "$version" ] || version="0.0.0"

  # 1. Build/refresh $ASSETS from real stock, never from a merged view.
  need_build=0
  if [ ! -d "$ASSETS" ] || [ ! -d "$ASSETS/i18n" ]; then
    need_build=1
  else
    stamp_epoch=$(mtime_epoch "$STAMP")
    for src in "$HOME_XML_SRC" "$EN_SED_SRC" "$BG_HD_SRC" "$BG_2K_SRC" "$BG_4K_SRC"; do
      s_epoch=$(mtime_epoch "$src")
      if [ "$s_epoch" -gt "$stamp_epoch" ] 2>/dev/null; then need_build=1; fi
    done
  fi

  if [ "$need_build" -eq 1 ]; then
    # Unmount first: if a bind is already active, reading the target now
    # would copy a merged view, never real stock.
    drain_umount "$STOCK_ASSETS"
    rm -rf "$ASSETS.building" 2>/dev/null
    mkdir -p "$ASSETS.building"
    cperr=$( (cd "$STOCK_ASSETS" && cp -R . "$ASSETS.building") 2>&1 >/dev/null )
    cprc=$?
    if [ "$cprc" -ne 0 ]; then
      log_line "apply: failed to copy stock assets: $cperr"
      ntfy_notify "LumaGlass apply failed: could not copy stock assets"
      emit_error "stock asset copy failed: $cperr"
      return 1
    fi
    # i18n is a symlink in real stock; dereference it into a real directory
    # so string overlays land inside the copy, not on the original target.
    if [ -L "$ASSETS.building/i18n" ]; then
      i18n_target=$(readlink "$ASSETS.building/i18n" 2>/dev/null)
      case "$i18n_target" in
        /*) : ;;
        *) i18n_target="$STOCK_ASSETS/$i18n_target" ;;
      esac
      if [ -n "$i18n_target" ] && [ -d "$i18n_target" ]; then
        rm -f "$ASSETS.building/i18n"
        mkdir -p "$ASSETS.building/i18n"
        ( cd "$i18n_target" && cp -R . "$ASSETS.building/i18n" ) 2>/dev/null
      fi
    fi
    # Keep a pristine copy of the stock strings. Every apply regenerates
    # en.json from this, so the greeting cannot freeze at a stale value the
    # way an in-place rewrite would (the sed rules match stock text only).
    if [ -f "$ASSETS.building/i18n/en.json" ]; then
      cp -f "$ASSETS.building/i18n/en.json" "$ASSETS.building/i18n/en.json.stock" 2>/dev/null
    fi
    rm -rf "$ASSETS" 2>/dev/null
    mv "$ASSETS.building" "$ASSETS"
    touch "$STAMP" 2>/dev/null
  fi

  # 2. Overlay payload onto $ASSETS.
  cp -f "$HOME_XML_SRC" "$ASSETS/home.xml" 2>/dev/null

  mkdir -p "$ASSETS/images/hd" "$ASSETS/images/2k" "$ASSETS/images/4k" 2>/dev/null
  cp -f "$BG_HD_SRC" "$ASSETS/images/hd/bg_banner_img.png" 2>/dev/null
  cp -f "$BG_2K_SRC" "$ASSETS/images/2k/bg_banner_img.png" 2>/dev/null
  cp -f "$BG_4K_SRC" "$ASSETS/images/4k/bg_banner_img.png" 2>/dev/null

  # Keep a pristine stock copy and always regenerate from it: rewriting
  # en.json in place would stop matching the stock keys on the second apply.
  # The greeting is owned by the compositor QML, not by these strings.
  if [ ! -f "$ASSETS/i18n/en.json.stock" ] && [ -f "$ASSETS/i18n/en.json" ]; then
    cp -f "$ASSETS/i18n/en.json" "$ASSETS/i18n/en.json.stock" 2>/dev/null
  fi
  if [ -f "$ASSETS/i18n/en.json.stock" ]; then
    sed -f "$EN_SED_SRC" "$ASSETS/i18n/en.json.stock" 2>/dev/null > "$ASSETS/i18n/en.json.tmp.$$" \
      && mv "$ASSETS/i18n/en.json.tmp.$$" "$ASSETS/i18n/en.json"
  fi

  # 3. Stage the compositor QML this apply would use, then decide what changed.
  #
  # The compositor picks our QML up through the import path (a shadow copy of
  # its module), not a bind, so there is nothing to unmount for it. Home still
  # reads its layout from a bound assets directory. A byte-identical set that
  # is already live and already served by a shadow-aware compositor is left
  # untouched, so a no-op apply neither remounts nor restarts anything.
  fps_now=$(cfg_get_bool fps); [ -n "$fps_now" ] || fps_now=false
  stage_compositor "$fps_now" "$COMPOSITOR_STAGE.next"

  changed=1
  if [ "$(md5sum < "$COMPOSITOR_STAGE.next" 2>/dev/null)" = "$(md5sum < "$COMPOSITOR_STAGE" 2>/dev/null)" ] \
     && [ "$(md5sum < "$WALL_SRC" 2>/dev/null)" = "$(md5sum < "$WALLPAPER_STAGE" 2>/dev/null)" ] \
     && all_binds_live && shadow_current && env_live; then
    changed=0
    rm -f "$COMPOSITOR_STAGE.next"
    log_line "apply: staged set unchanged, shadow current, assets bound, not remounting"
  fi

  if [ "$changed" -eq 1 ]; then
    cp -f "$WALL_SRC" "$WALLPAPER_STAGE" 2>/dev/null
    mv -f "$COMPOSITOR_STAGE.next" "$COMPOSITOR_STAGE"

    # 4. Build the shadow compositor module and point the compositor's env
    # file at it. This is what a freshly starting compositor reads; nothing
    # is mounted for it.
    if ! build_shadow; then
      log_line "apply: could not build shadow compositor module"
      do_revert_internal
      ntfy_notify "LumaGlass apply failed: could not build compositor module"
      emit_error "shadow module build failed"
      return 1
    fi
    if ! write_env; then
      log_line "apply: could not write compositor env file"
      do_revert_internal
      ntfy_notify "LumaGlass apply failed: could not write compositor env"
      emit_error "compositor env write failed"
      return 1
    fi

    # 5. Bind Home's assets (its layout, strings and banner images).
    drain_umount "$STOCK_ASSETS"
    binderr=$(mount --bind "$ASSETS" "$STOCK_ASSETS" 2>&1 >/dev/null)
    if [ $? -ne 0 ]; then
      log_line "apply: bind failed on assets: $binderr"
      do_revert_internal
      ntfy_notify "LumaGlass apply failed: assets bind failed"
      emit_error "assets bind failed: $binderr"
      return 1
    fi
    if ! is_mounted "$STOCK_ASSETS"; then
      log_line "apply: assets bind verification failed"
      do_revert_internal
      ntfy_notify "LumaGlass apply failed: bind verification failed"
      emit_error "assets bind verification failed"
      return 1
    fi
    record_bound_now
  fi

  # 6. Bring the change on screen.
  #
  # The compositor only reads QML at startup, so the shadow reaches the screen
  # when it next starts, and its first start at boot+2.6s cannot see the env
  # file (see the constants block: /var is not the writable filesystem that
  # early). So the restart is the mechanism, not a fallback: if the compositor
  # that is running does not have the shadow, restart it.
  #
  # Deliberately NOT gated on panel_is_active. That gate was here to avoid
  # racing a power transition, and it silently abandoned the restart instead:
  # on a boot where the panel had not finished waking, apply skipped it, and
  # nothing ever retried, so the set ran the whole session on stock QML under
  # a modded Home layout. A restart while the panel is dark is invisible;
  # never restarting is not. restart_surface cleans up the crash reports the
  # restart provokes, which is what keeps power-off immediate.
  restart_needed=0
  if surface_start_uptime >/dev/null 2>&1 && ! compositor_has_shadow; then
    restart_needed=1
  fi

  if [ "$restart_needed" -eq 1 ]; then
    marker=$(wc -l < "$MSGLOG" 2>/dev/null | tr -d ' '); [ -n "$marker" ] || marker=0
    if ! restart_surface; then
      log_line "apply: surface-manager-daemon did not come back active"
      do_revert_internal
      ntfy_notify "LumaGlass apply failed: compositor did not restart"
      emit_error "compositor did not become active after restart"
      return 1
    fi
    log_line "apply: compositor restarted to read shadow module"
    home_back_after_restart
    if sed -n "$((marker+1)),\$p" "$MSGLOG" 2>/dev/null | grep -qa 'shader compilation failed'; then
      log_line "apply: shader compilation failure detected post-restart, auto-reverting"
      rm -f "$VERIFIED"
      do_revert_internal
      ntfy_notify "LumaGlass apply failed: shader compilation error, auto-reverted to stock"
      emit_error "shader compilation failed; auto-reverted to stock"
      return 1
    fi
  elif [ "$changed" -eq 1 ]; then
    # Compositor already serves the shadow (or is not yet up); only Home needs
    # to re-read the freshly bound assets.
    kill_home_app
    relaunch_home
  fi
  staged_hash > "$VERIFIED"

  mounts=$(count_mounts)
  took=$(( $(date +%s) - t0 ))
  log_line "apply: success version=$version mounts=$mounts took=${took}s"
  ntfy_notify "LumaGlass applied (v$version)"
  printf '{"ok":true,"applied":true,"mounts":%s,"took":%s}\n' "$mounts" "$took"
  return 0
}

# ---------------------------------------------------------------- boot-bind

verb_boot_bind() {
  # The boot hook's opening move. The compositor's first start is always
  # stock - at 2.63s /var is not yet the writable filesystem, so its optional
  # EnvironmentFile read finds nothing (see the constants block) - and the
  # apply that follows this restarts it. Binding first matters: the bind is
  # what Home re-reads, and the restart kills Home anyway.
  #
  # What this does is bind Home's assets - a bind mount does not survive a
  # reboot - and check the two things that can make a persistent env file
  # dangerous.
  #
  # 1. A firmware update replaces the stock compositor module. Our shadow was
  #    built from the old one, so it would feed stale QML to new libraries.
  #    Rebuild it; if that fails, drop the env file so the set is stock.
  # 2. Our QML could stop the compositor from starting at all. Unlike a bind,
  #    a persistent env file would repeat that on every boot. If the hook runs
  #    and no compositor is up, drop the env file and restart, which puts the
  #    TV back on stock rather than leaving a black screen.
  if ! take_mutation_lock; then
    emit_error "another apply or revert is still running"
    return 1
  fi
  if [ -f "$BOOT_PENDING" ]; then
    rm -f "$BOOT_PENDING"
    log_line "boot-bind: previous boot never completed, skipping fast path once"
    printf '{"ok":true,"bound":false,"reason":"failsafe"}\n'
    return 0
  fi
  if [ ! -f "$COMPOSITOR_STAGE" ] || [ ! -f "$WALLPAPER_STAGE" ] || [ ! -f "$ASSETS/home.xml" ] || [ ! -d "$ASSETS/i18n" ]; then
    log_line "boot-bind: no staged set, leaving it to apply"
    printf '{"ok":true,"bound":false,"reason":"no-stage"}\n'
    return 0
  fi
  if [ "$(staged_hash)" != "$(cat "$VERIFIED" 2>/dev/null)" ]; then
    log_line "boot-bind: staged set is not the verified one, leaving it to apply"
    printf '{"ok":true,"bound":false,"reason":"unverified"}\n'
    return 0
  fi

  touch "$BOOT_PENDING"

  # Fail safe first: a compositor that never came up outranks everything else.
  if [ -f "$ENV_FILE" ] && ! surface_start_uptime >/dev/null 2>&1; then
    log_line "boot-bind: no compositor running with our env file present, reverting to stock"
    remove_env
    systemctl restart "$SURFACE_SVC" >/dev/null 2>&1
    ntfy_notify "LumaGlass disabled itself: compositor did not start"
    printf '{"ok":true,"bound":false,"reason":"compositor-absent"}\n'
    return 0
  fi

  if ! shadow_current; then
    # Either the firmware replaced the stock module, or the shadow itself is
    # damaged - a power cut mid-build leaves every file present and most of
    # them truncated. Both mean the module on disk cannot be trusted.
    log_line "boot-bind: shadow module not current (stale or damaged), rebuilding"
    if build_shadow; then
      log_line "boot-bind: shadow module rebuilt"
      # The compositor started before this hook did. If it loaded the module we
      # have just replaced, it is running on the bad one - and a compositor
      # that started on a truncated module comes up healthy and presents
      # nothing, so no liveness check catches it. Restart it once.
      if compositor_has_shadow && panel_is_active; then
        log_line "boot-bind: compositor had loaded the damaged module, restarting it"
        restart_surface >/dev/null 2>&1
        home_back_after_restart
      fi
    else
      log_line "boot-bind: shadow rebuild failed, dropping env file"
      remove_env
      if compositor_has_shadow && panel_is_active; then
        restart_surface >/dev/null 2>&1
        home_back_after_restart
      fi
      ntfy_notify "LumaGlass disabled itself: compositor module unusable"
      printf '{"ok":true,"bound":false,"reason":"stale-module"}\n'
      return 0
    fi
  fi
  write_env

  n=0
  if ! is_mounted "$STOCK_ASSETS"; then
    mount --bind "$ASSETS" "$STOCK_ASSETS" >/dev/null 2>&1 && n=$((n+1))
  fi
  if all_binds_live; then
    record_bound_now
    log_line "boot-bind: $n bind(s) made, assets live, compositor already on shadow=$(compositor_has_shadow && echo yes || echo no)"
    printf '{"ok":true,"bound":true,"mounts":%s}\n' "$(count_mounts)"
  else
    log_line "boot-bind: assets bind incomplete, leaving it to apply"
    printf '{"ok":true,"bound":false,"reason":"incomplete"}\n'
  fi
  return 0
}

verb_boot_ok() {
  # Called by the boot hook once the boot's apply reported ok.
  rm -f "$BOOT_PENDING"
  printf '{"ok":true}\n'
  return 0
}

# ------------------------------------------------------------------- status

verb_status() {
  ensure_config
  version=$(get_version); [ -n "$version" ] || version="0.0.0"
  mounts=$(count_mounts)
  # Applied means both halves are in place: Home's assets bound, and a
  # starting compositor pointed at our module. Mount count alone stopped
  # being the answer when the compositor moved off a bind onto the import
  # path. "live" is whether the compositor running right now has it.
  if [ "$mounts" -gt 0 ] && env_live && [ -d "$SHADOW_ROOT" ]; then applied=true; else applied=false; fi
  if compositor_has_shadow; then live=true; else live=false; fi
  if [ -L "$AUTOSTART_LINK" ]; then persist=true; else persist=false; fi
  if early_hook_live; then early=true; else early=false; fi
  fps=$(cfg_get_bool fps); [ "$fps" = "true" ] && fps=true || fps=false
  ntfy_en=$(cfg_get_bool enabled); [ "$ntfy_en" = "true" ] && ntfy_en=true || ntfy_en=false
  ntfy_url_esc=$(json_escape "$(cfg_get_str url)")
  firmware_esc=$(json_escape "$(get_firmware)")
  model_esc=$(json_escape "$(get_model)")
  standby=$(standby_mode)
  printf '{"ok":true,"version":"%s","applied":%s,"live":%s,"mounts":%s,"persist":%s,"early":%s,"standby":"%s","fps":%s,"ntfy":{"enabled":%s,"url":"%s"},"firmware":"%s","model":"%s"}\n' \
    "$version" "$applied" "$live" "$mounts" "$persist" "$early" "$standby" "$fps" "$ntfy_en" "$ntfy_url_esc" "$firmware_esc" "$model_esc"
  return 0
}

# --------------------------------------------------------- early boot hook

install_early_hook() {
  # PATH for kdump.service, plus the shim it will resolve `grep` to.
  mkdir -p "$EARLY_BIN" "$(dirname "$EARLY_ENV_FILE")" 2>/dev/null || return 1
  {
    printf '%s\n' '#!/bin/sh'
    printf '%s\n' '# LumaGlass early boot trigger, installed as a PATH shim in front of grep'
    printf '%s\n' '# for kdump.service only. It starts the apply ~19s earlier than Homebrew'
    printf '%s\n' "# Channel's init.d run-parts can, then behaves exactly like grep."
    printf '%s\n' '#'
    printf '%s\n' '# Absolute paths throughout: this shim is first on PATH, so a bare grep'
    printf '%s\n' '# here would re-enter it. Every path still ends in exec, so nothing here'
    printf '%s\n' '# can stop the unit that called it.'
    printf 'APPDIR=%s\n' "$APPDIR"
    printf 'STATE=%s\n' "$STATE"
    printf 'ONCE=%s\n' "$EARLY_ONCE"
    cat <<'SHIM'
if [ ! -e "$ONCE" ]; then
  : > "$ONCE" 2>/dev/null
  if /bin/grep -q '"persist"[[:space:]]*:[[:space:]]*true' "$STATE/config.json" 2>/dev/null; then
    if [ -x "$APPDIR/tools/autostart.sh" ]; then
      PATH=/usr/sbin:/usr/bin:/sbin:/bin \
        /usr/bin/setsid "$APPDIR/tools/autostart.sh" --worker </dev/null >/dev/null 2>&1 &
    fi
  fi
fi
exec /bin/grep "$@"
SHIM
  } > "$EARLY_SHIM.tmp.$$" || return 1
  chmod 0755 "$EARLY_SHIM.tmp.$$" 2>/dev/null
  mv -f "$EARLY_SHIM.tmp.$$" "$EARLY_SHIM" 2>/dev/null || return 1
  printf 'PATH=%s:/usr/sbin:/usr/bin:/sbin:/bin\n' "$EARLY_BIN" > "$EARLY_ENV_FILE.tmp.$$" || return 1
  mv -f "$EARLY_ENV_FILE.tmp.$$" "$EARLY_ENV_FILE" 2>/dev/null || return 1
  sync
  return 0
}

remove_early_hook() {
  rm -f "$EARLY_ENV_FILE" "$EARLY_ENV_FILE.tmp."* 2>/dev/null
  rm -rf "$EARLY_BIN" 2>/dev/null
  return 0
}

early_hook_live() {
  [ -f "$EARLY_ENV_FILE" ] && [ -x "$EARLY_SHIM" ] \
    && grep -qF "$EARLY_BIN" "$EARLY_ENV_FILE" 2>/dev/null
}

# ------------------------------------------------------------------ persist

verb_persist() {
  action="${1:-}"
  case "$action" in
    on)
      mkdir -p "$(dirname "$AUTOSTART_LINK")" 2>/dev/null
      rm -f "$AUTOSTART_LINK" 2>/dev/null
      if ! ln -s "$AUTOSTART_SRC" "$AUTOSTART_LINK" 2>/dev/null; then
        emit_error "failed to create persist symlink"
        return 1
      fi
      set_cfg_bool persist true
      # The init.d symlink is the safety net; the early hook is what makes a
      # boot fast. Its absence is not fatal - the late hook still applies.
      if ! install_early_hook; then
        log_line "persist: early hook could not be installed, late hook only"
      fi
      ;;
    off)
      rm -f "$AUTOSTART_LINK" 2>/dev/null
      remove_early_hook
      set_cfg_bool persist false
      ;;
    *)
      emit_error "persist requires on or off"
      return 1
      ;;
  esac
  if [ -L "$AUTOSTART_LINK" ]; then real=true; else real=false; fi
  log_line "persist: set to $action (symlink=$real)"
  printf '{"ok":true,"persist":%s}\n' "$real"
  return 0
}

# ---------------------------------------------------------------------- fps

verb_fps() {
  action="${1:-}"
  case "$action" in
    on) val=true ;;
    off) val=false ;;
    *) emit_error "fps requires on or off"; return 1 ;;
  esac
  set_cfg_bool fps "$val"
  # The overlay is a property in the staged QML, so flipping it is a re-apply:
  # apply sees the staged set change, rebinds once per distinct target, takes
  # the mutation lock, and runs the shader verification. The old inline
  # version bound both QML paths - the same inode - and stacked two mounts.
  if [ "$(count_mounts)" -gt 0 ]; then
    if ! verb_apply >/dev/null; then
      emit_error "fps set, but re-apply failed; see log"
      return 1
    fi
  fi
  log_line "fps: set to $val"
  printf '{"ok":true,"fps":%s}\n' "$val"
  return 0
}

# ------------------------------------------------------------------ standby

SETTINGS_GET_URI="luna://com.webos.settingsservice/getSystemSettings"
SETTINGS_SET_URI="luna://com.webos.settingsservice/setSystemSettings"

get_option_setting() {
  # $1 = key in the "option" category. Prints the value, or nothing.
  luna-send -n 1 "$SETTINGS_GET_URI" "{\"category\":\"option\",\"keys\":[\"$1\"]}" 2>/dev/null \
    | tr -d '\n' | sed -n "s/.*\"$1\"[ ]*:[ ]*\"\\([^\"]*\\)\".*/\\1/p"
}

set_option_setting() {
  # $1 = key, $2 = value. The set's own settings service, so the change is
  # what the TV's menus would have done and it persists the same way.
  luna-send -n 1 "$SETTINGS_SET_URI" \
    "{\"category\":\"option\",\"settings\":{\"$1\":\"$2\"}}" 2>/dev/null \
    | tr -d '\n' | grep -q '"returnValue"[ ]*:[ ]*true'
}

standby_mode() {
  # What the set will do at the next power-off, read from the live settings
  # rather than from anything stored here. "warm": stays in active standby
  # with RAM alive and powers on instantly with the mod still up. "cold":
  # powers fully down and every power-on is a boot. "system": Quick Start+
  # is on but SDDP is still enabled - the stock state, which on a set with a
  # VPN tun interface means webos-sddp crashes on the next network change and
  # the power-off after that reboots.
  qs=$(get_option_setting quickStartMode)
  sddp=$(get_option_setting enableSDDP)
  if [ "$qs" != "on" ]; then
    printf 'cold\n'
  elif [ "$sddp" = "off" ]; then
    printf 'warm\n'
  else
    printf 'system\n'
  fi
}

verb_standby() {
  # Two things decide whether a power-off leaves the set warm: Quick Start+
  # (LG's own "keep it in RAM" mode) and the absence of a crash report when
  # faultmanager looks. The report this mod's own restart produces is always
  # swept. The other one seen is webos-sddp (Control4 discovery), which
  # segfaults in SDDPSetDevice whenever it reads the interface list and finds
  # a point-to-point interface with the multicast flag - a Tailscale tun on
  # the reference set; proven by stopping tailscaled, after which it runs. A
  # stock set has no such interface. It is handled by not starting it, through
  # the set's own enableSDDP setting; the previous value is kept so "cold"
  # restores it.
  action="${1:-}"
  cfg_read_all
  case "$action" in
    warm)
      if [ -z "$CFG_SDDP_PREV" ]; then
        prev=$(get_option_setting enableSDDP); [ -n "$prev" ] || prev=on
        set_cfg_sddp_prev "$prev"
      fi
      set_option_setting enableSDDP off || { emit_error "could not turn off enableSDDP"; return 1; }
      set_option_setting quickStartMode on || { emit_error "could not turn on quickStartMode"; return 1; }
      ;;
    cold)
      set_option_setting quickStartMode off || { emit_error "could not turn off quickStartMode"; return 1; }
      if [ -n "$CFG_SDDP_PREV" ]; then
        set_option_setting enableSDDP "$CFG_SDDP_PREV" || { emit_error "could not restore enableSDDP"; return 1; }
        set_cfg_sddp_prev ""
      fi
      ;;
    *)
      emit_error "standby requires warm or cold"
      return 1
      ;;
  esac
  mode=$(standby_mode)
  log_line "standby: set to $action (now $mode)"
  printf '{"ok":true,"standby":"%s"}\n' "$mode"
  return 0
}

# --------------------------------------------------------------------- ntfy

verb_ntfy() {
  action="${1:-}"
  case "$action" in
    set)
      url="${2:-}"
      case "$url" in
        http://*/*|https://*/*) : ;;
        *) emit_error "ntfy url must be http(s) with a topic path"; return 1 ;;
      esac
      set_cfg_ntfy_url "$url"
      set_cfg_bool enabled true
      log_line "ntfy: configured"
      ;;
    off)
      set_cfg_bool enabled false
      log_line "ntfy: disabled"
      ;;
    test)
      cfg_read_all
      if [ "$CFG_NTFY_ENABLED" != "true" ] || [ -z "$CFG_NTFY_URL" ]; then
        emit_error "ntfy is not configured"
        return 1
      fi
      if ! curl -fsS -m 10 -H 'Title: LumaGlass' -H 'Tags: tv' -d 'LumaGlass test notification' "$CFG_NTFY_URL" >/dev/null 2>&1; then
        log_line "ntfy: test delivery failed"
        emit_error "ntfy test failed to deliver"
        return 1
      fi
      log_line "ntfy: test delivered"
      ;;
    *)
      emit_error "ntfy requires set <url>, off, or test"
      return 1
      ;;
  esac
  cfg_read_all
  url_esc=$(json_escape "$CFG_NTFY_URL")
  printf '{"ok":true,"ntfy":{"enabled":%s,"url":"%s"}}\n' "$CFG_NTFY_ENABLED" "$url_esc"
  return 0
}

# ---------------------------------------------------------------------- log

verb_log() {
  n="${1:-}"
  case "$n" in ''|*[!0-9]*) n=20 ;; esac
  mkdir -p "$STATE" 2>/dev/null
  touch "$LOGFILE" 2>/dev/null
  out=""
  while IFS= read -r line || [ -n "$line" ]; do
    esc=$(json_escape "$line")
    if [ -z "$out" ]; then out="\"$esc\""; else out="$out,\"$esc\""; fi
  done <<LGEOF
$(tail -n "$n" "$LOGFILE" 2>/dev/null)
LGEOF
  printf '{"ok":true,"lines":[%s]}\n' "$out"
  return 0
}

# ------------------------------------------------------------------ version

verb_version() {
  v=$(get_version); [ -n "$v" ] || v="0.0.0"
  printf '{"ok":true,"version":"%s"}\n' "$v"
  return 0
}

# ------------------------------------------------------------------- dispatch

ensure_config

case "$VERB" in
  status) verb_status; exit $? ;;
  apply) verb_apply; exit $? ;;
  boot-bind) verb_boot_bind; exit $? ;;
  boot-ok) verb_boot_ok; exit $? ;;
  revert) verb_revert; exit $? ;;
  persist) verb_persist "${2:-}"; exit $? ;;
  fps) verb_fps "${2:-}"; exit $? ;;
  standby) verb_standby "${2:-}"; exit $? ;;
  ntfy) verb_ntfy "${2:-}" "${3:-}"; exit $? ;;
  log) verb_log "${2:-}"; exit $? ;;
  version) verb_version; exit $? ;;
  *) emit_error "unknown verb: $VERB"; exit 1 ;;
esac
